{
  "name": "lifestitchr-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "check:ui": "node scripts/check-ui.mjs",
    "check:exit": "node scripts/check-card-exit.mjs",
    "check:rarity": "node scripts/check-rarity-effects.mjs",
    "check:menu": "node scripts/check-mode-menu.mjs",
    "check:variants": "node scripts/check-variants.mjs",
    "check:reset": "node scripts/check-clear-packs.mjs",
    "check:modes": "node scripts/check-modes.mjs && node scripts/check-mode-failures.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
