{
  "cleanUrls": true,
  "functions": {
    "api/refresh.js": {
      "maxDuration": 10
    },
    "api/cards.js": {
      "maxDuration": 15
    },
    "api/imgbb-key.js": {
      "maxDuration": 5
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/anarchy",
      "destination": "/index.html"
    },
    {
      "source": "/anarchy/",
      "destination": "/index.html"
    },
    {
      "source": "/anarchy.html",
      "destination": "/index.html"
    },
    {
      "source": "/packs",
      "destination": "/index.html"
    },
    {
      "source": "/packs/",
      "destination": "/index.html"
    },
    {
      "source": "/packs/index.html",
      "destination": "/index.html"
    }
  ]
}
